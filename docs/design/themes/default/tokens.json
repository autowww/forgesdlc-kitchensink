{
  "schemaVersion": 1,
  "themeId": "default",
  "source": "current-ks",
  "palette": {
    "background": "#0A0E17",
    "surface": "#111827",
    "surfaceRaised": "#172033",
    "text": "#E5E7EB",
    "mutedText": "#9CA3AF",
    "accentPrimary": "#F59E0B",
    "accentSecondary": "#06B6D4"
  },
  "typography": {
    "display": "Proxima Nova Black",
    "body": "Open Sans",
    "mono": "Courier New"
  },
  "spacing": {
    "sectionRhythm": ["3rem", "4rem", "5rem"],
    "contentMaxWidth": "1200px",
    "readableLineLength": "72ch",
    "cssVariables": {
      "shellMax": "--fs-shell-max (marketing/product chrome bands)",
      "proseMax": "--ks-prose-max (handbook: min(72ch, 56rem); xl ≥1400px: min(85ch, 75rem))",
      "proseMaxXl": "75rem / 1200px at min-width 1400px",
      "bodySize": "--ks-body-size (maps to --bs-body-font-size)",
      "supportSize": "--ks-support-size (.forge-support)"
    }
  },
  "surfaces": {
    "radius": ["0.75rem", "1rem", "1.25rem"],
    "border": "rgba(148, 163, 184, 0.24)",
    "shadow": "0 24px 80px rgba(0, 0, 0, 0.32)"
  },
  "motion": {
    "prefersReducedMotionRequired": true,
    "ambientMotion": "subtle"
  },
  "density": {
    "heroInteractiveLimit": 4,
    "cardActionLimit": 1,
    "navBandLimit": 2
  }
}
