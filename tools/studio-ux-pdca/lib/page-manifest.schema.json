{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioUxPageManifest",
  "type": "object",
  "required": ["version", "consumer_id", "studio_base_url", "pages"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "consumer_id": { "type": "string" },
    "studio_base_url": { "type": "string", "format": "uri" },
    "default_min_scores": {
      "type": "object",
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 100 },
        "enterprise_ux": { "type": "number", "minimum": 0, "maximum": 100 },
        "human_friendliness": { "type": "number", "minimum": 0, "maximum": 100 },
        "wiki_functionality": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "path", "title"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "type": "string" },
          "title": { "type": "string" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["click", "wait", "goto_tab", "goto_rail"] },
                "selector": { "type": "string" },
                "role": { "type": "string" },
                "name": { "type": "string" },
                "ms": { "type": "integer" }
              }
            }
          },
          "feature_ids": { "type": "array", "items": { "type": "string" } },
          "wiki_page_ids": { "type": "array", "items": { "type": "string" } },
          "playwright_test_glob": { "type": "string" },
          "min_scores": {
            "type": "object",
            "properties": {
              "overall": { "type": "number" },
              "enterprise_ux": { "type": "number" },
              "human_friendliness": { "type": "number" },
              "wiki_functionality": { "type": "number" }
            }
          },
          "requires_dual_wiki_gate": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
