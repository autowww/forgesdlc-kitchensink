- Layout: `landing-hero`, `landing-hero-wide`, `landing-hero-grid`, `landing-hero-copy`, `fs-landing-hero-band`, `forge-section`
- Typography: `font-display`, `forge-gradient-text`, `product-landing-title`, `forge-support`, `landing-hero-tagline`
- CTA stack: `landing-hero-actions`, `landing-hero-actions__buttons`, `btn btn-forge`, `btn btn-cyan-outline`, `landing-hero-secondary-links`, `landing-hero-secondary-link`, `landing-hero-secondary-sep`
