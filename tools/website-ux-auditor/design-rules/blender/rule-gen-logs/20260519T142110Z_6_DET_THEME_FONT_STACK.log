### 2. New check — `design-rules/deterministic/generated/det-theme-font-stack.check.js`

```javascript
/**
 * DET.THEME.FONT_STACK — body and primary content use KS theme font stacks.
 * @see docs/design/ux-audit/deterministic-design-rules.md#det-theme-font_stack
 */

const KS_FONT_VAR_RE =
  /^var\(\s*--(?:ks|forge)-font-family-(?:sans|serif|mono)\s*(?:,[^)]+)?\)$/i;

const ALLOWED_GENERIC = new Set([
  'system-ui',
  'ui-sans-serif',
  'ui-serif',
  'ui-monospace',
  'sans-serif',
  'serif',
  'monospace',
]);

const ALLOWED_NAMED = new Set([
  'inter',
  'jetbrains mono',
  'source serif 4',
  'segoe ui',
  'roboto',
  'helvetica neue',
  'arial',
  'noto sans',
  'noto serif',
  'noto sans mono',
]);

const SAMPLE_SELECTORS = ['body', 'main', '[role="main"]', 'article', 'h1', 'p'];

export const rule = {
  id: 'DET.THEME.FONT_STACK',
  title: 'Theme font stacks match Kitchen Sink tokens',
  severity: 'major',
  area: 'theme',
  scoreDimension: 'visual_consistency',
  priorityWeight: 0.85,
  docsAnchor: 'det-theme-font_stack',
};

function normalizePart(part) {
  return String(part || '')
    .trim()
    .replace(/^['"]|['"]$/g, '')
    .toLowerCase();
}

function parseFontFamily(fontFamily) {
  if (!fontFamily || typeof fontFamily !== 'string') return [];
  return fontFamily.split(',').map(normalizePart).filter(Boolean);
}

function partAllowed(part) {
  if (!part) return false;
  if (KS_FONT_VAR_RE.test(part)) return true;
  if (part.startsWith('var(') && /--(?:ks|forge)-font-family-(?:sans|serif|mono)/i.test(part)) {
    return true;
  }
  if (ALLOWED_GENERIC.has(part)) return true;
  if (ALLOWED_NAMED.has(part)) return true;
  return false;
}

function stackAllowed(fontFamily) {
  const parts = parseFontFamily(fontFamily);
  if (parts.length === 0) return false;
  return parts.every(partAllowed);
}

function sampleElements(document) {
  const seen = new Set();
  const out = [];
  for (const selector of SAMPLE_SELECTORS) {
    for (const el of document.querySelectorAll(selector)) {
      if (seen.has(el)) continue;
      seen.add(el);
      out.push({ el, selector });
      if (out.length >= 10) return out;
    }
  }
  return out;
}

export function run(ctx) {
  const document = ctx?.document;
  const getComputedStyle = ctx?.getComputedStyle;
  if (!document || typeof getComputedStyle !== 'function') return [];

  const findings = [];
  for (const { el, selector } of sampleElements(document)) {
    const fontFamily = getComputedStyle(el).fontFamily;
    if (stackAllowed(fontFamily)) continue;
    findings.push({
      ruleId: rule.id,
      severity: rule.severity,
      area: rule.area,
      message:
        'Computed font-family is not a Kitchen Sink theme stack (use --ks-font-family-* / --forge-font-family-* tokens with approved fallbacks).',
      evidence: { selector, fontFamily, parsed: parseFontFamily(fontFamily) },
      remediation: {
        summary: 'Set font-family via KS theme CSS variables on body and content roots.',
        docsAnchor: rule.docsAnchor,
      },
    });
  }
  return findings;
}
```

