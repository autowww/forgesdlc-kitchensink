{
  "name": "forge-website-a11y-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge Website Accessibility Auditor — WCAG/axe + scoped DET/AI rules for generic and KS-driven sites.",
  "scripts": {
    "audit": "node analyze-website-a11y.mjs",
    "score": "node score-website-a11y.mjs",
    "score-compliance": "node score-compliance-a11y.mjs",
    "build-standards-packs": "node design-rules/blender/build-standards-packs.mjs",
    "validate-pack": "node validate-standards-pack.mjs",
    "blend-rules": "node design-rules/blender/a11y-rules-blender.mjs",
    "sync-wcag-md": "node scripts/sync-wcag-reference-markdown.mjs",
    "wire-catalog-docpath": "node scripts/wire-catalog-docpath.mjs",
    "export-axe-catalog": "node scripts/export-axe-catalog.mjs",
    "merge-ai-audit": "node scripts/merge-ai-audit-findings.mjs",
    "run-ai-fixers": "node lib/a11y-ai-fixers/run-ai-fixers.mjs",
    "import-wcag3-catalog": "node scripts/import-wcag3-draft-catalog.mjs",
    "inventory-a11y-stubs": "node scripts/inventory-a11y-stubs.mjs",
    "test": "node --test auditor-tests/*.test.js && npm run sync-wcag-md -- --check && npm run wire-catalog-docpath -- --check && npm run export-axe-catalog -- --check",
    "install-browsers": "playwright install chromium",
    "vendor:axe": "node -e \"const fs=require('fs');const p=require('path');const d=p.join('node_modules','axe-core','axe.min.js');const t=p.join('vendor','axe.min.js');if(fs.existsSync(d)){fs.mkdirSync('vendor',{recursive:true});fs.copyFileSync(d,t);}else process.exit(1);\""
  },
  "dependencies": {
    "axe-core": "^4.11.3"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=18"
  }
}
